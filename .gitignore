# instructor material: kept out of the public repository
# (gitignore has no inline comments: keep each pattern on its own line)
# master/    -> the source notebooks, with the answers
# solutions/ -> the instructor versions built from them
master/
solutions/

# notebook outputs and scratch files
*.parquet
!data/top10_reference.parquet
*.gpkg
broken/
cert-*.png
notebooks/*.png
.ipynb_checkpoints/
__pycache__/
*.pyc

# build by-products
*.pdf

# macOS
.DS_Store

# session 2 ships PDFs and a GeoPackage as course data:
# they must survive the patterns above
!data/*.pdf
!data/*.gpkg
